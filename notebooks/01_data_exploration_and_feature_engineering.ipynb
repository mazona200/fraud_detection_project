# Cell 5: Claims EDA — amounts, counts, temporal patterns
def parse_dates(df):
    date_cols = [c for c in df.columns if "date" in c.lower() or "dt" in c.lower()]
    for c in date_cols:
        try:
            df[c] = pd.to_datetime(df[c], errors="coerce")
        except Exception:
            pass
    return df, date_cols

